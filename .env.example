# ==============================================================================
# RoseOne — Production & Netlify Environment Variables Configuration
# ==============================================================================

# --- Frontend Client Configuration (Vite) ---
# When deployed to Netlify using built-in Netlify Functions, leave VITE_API_URL blank.
# If hosting the Express backend on an external container (Render, Railway, Fly.io, VPS),
# specify the full public URL of your API service (e.g., https://api.yourdomain.com):
VITE_API_URL=

# Fallback alias for custom microservices
VITE_API_BASE_URL=

# --- Node.js Server & Backend Configuration (Standalone / VPS / Render) ---
# Port for the Node.js / Express production server (defaults to 3000)
PORT=3000

# Node environment mode: 'production' or 'development'
NODE_ENV=production

# Cryptographic salt and session secret for signing tokens
SESSION_SECRET=

# --- Cloud Media Storage (Optional) ---
# By default, RoseOne persists uploaded media locally to public/uploads or /tmp
# To persist media to an Amazon S3 or S3-compatible bucket (e.g. Cloudflare R2, MinIO):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
